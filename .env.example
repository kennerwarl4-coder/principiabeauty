# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA versione o arquivo ".env" (ele contém chaves secretas).

# BravoPay > Dashboard > API Keys (começa com bp_live_)
BRAVOPAY_API_KEY=
# BravoPay > Dashboard > Integrações > cadastre a URL https://SEU_DOMINIO/api/pix/webhook
# e cole aqui o secret "whsec_..." mostrado. Sem ele o webhook reconsulta cada transação na API.
BRAVOPAY_WEBHOOK_SECRET=
# Opcional: ID de um produto real da BravoPay (GET /api/v1/products). Recomendado se a
# integração UTMify estiver ligada no painel da BravoPay (sem isso a venda vai como "API Charge").
BRAVOPAY_PRODUCT_ID=

# Gerenciador de Eventos (business.facebook.com/events_manager) > seu pixel > Configurações > Conversions API
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos. Enquanto definido, os
# eventos de Purchase só aparecem no teste e NÃO contam como conversão real nos anúncios.
# Remova/deixe em branco para valer pra valer em produção.
META_TEST_EVENT_CODE=

# Painel UTMify > Integrações > Webhooks > "Credenciais de API" > Adicionar Credencial > Criar Credencial
UTMIFY_API_TOKEN=

# URL pública do site (usada como event_source_url no Meta CAPI).
# Em produção, defina o domínio real, ex: https://www.principiabeauty.site
PUBLIC_BASE_URL=

# Porta em que o servidor Express vai escutar (uso local apenas)
PORT=3000
